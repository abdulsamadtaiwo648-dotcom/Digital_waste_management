# Copy to .env for local development. Never put real credentials in this file.
DATABASE_URL=postgres://dwmp:change-me@localhost:5432/dwmp?sslmode=disable
SESSION_SECRET=replace-with-at-least-32-random-characters
PYTHON_PROCESSOR_URL=http://localhost:8090
SERVICE_ROLE=resident
SERVICE_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
APP_ENV=development
DEV_RESET_LINKS=false
# Set only for the one-time first administrator bootstrap command.
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-temporary-secret
PAYMENT_MODE=disabled
SIMULATOR_ENABLED=false
SIMULATOR_DEVICE_ID=
SIMULATOR_DEVICE_TOKEN=
SIMULATOR_DEPTH_CM=100
SIMULATOR_MIN_DISTANCE_CM=2
SIMULATOR_INSTALLATION_OFFSET_CM=0
SIMULATOR_INTERVAL_SECONDS=30
PORT=8080
