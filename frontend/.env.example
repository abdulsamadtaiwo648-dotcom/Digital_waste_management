# Copy to .env.production and replace the example hostnames before building.
# For a site whose root URL is the management or admin app, set VITE_APP_ROLE
# to that role. The explicit management.html and admin.html pages select their
# own API automatically.
VITE_APP_ROLE=resident
VITE_RESIDENT_API_URL=https://resident-api.example.com/api/v1
VITE_MANAGEMENT_API_URL=https://management-api.example.com/api/v1
VITE_ADMIN_API_URL=https://admin-api.example.com/api/v1
